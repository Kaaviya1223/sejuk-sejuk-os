# Copy to .env and fill in. Never commit .env itself.

# Supabase project settings → API.
# The VITE_ prefix ships these to the browser, which is correct here: the
# publishable key is designed to be public and is what the front end connects
# with.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Google AI Studio key for the operations assistant.
# No VITE_ prefix on purpose — anything prefixed VITE_ is inlined into the
# JavaScript bundle and readable by every visitor. This key is only ever read
# by the serverless function in api/, never by the front end.
GEMINI_API_KEY=your-google-ai-studio-key

# Optional. Tried first, ahead of the built-in candidate list in
# src/lib/gemini.js. It sets the preference rather than replacing the list, so
# a per-model quota exhaustion still falls through to the next candidate.
# GEMINI_MODEL=gemini-flash-latest

# Optional. The number the "job complete" notice to the manager is addressed to.
# Without it the message is still generated and logged, but the link opens
# WhatsApp with no recipient chosen.
# MANAGER_WHATSAPP=60123456789

# Optional. Points the whole technician roster at one handset so a generated job
# brief actually arrives while you test. Unset, the wa.me link still opens with
# the brief pre-filled for you to address by hand.
# Keep this in a local .env only. VITE_ values are inlined into the JavaScript
# bundle, so setting it on a deployment publishes the number to every visitor.
# VITE_DEMO_PHONE=60123456789
